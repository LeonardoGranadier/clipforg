# Copie este arquivo para .env e preencha. O .env nunca deve ir para o git.

# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Modelo do Claude usado para sugerir os cortes
CLAUDE_MODEL=claude-sonnet-5

# Transcrição (faster-whisper)
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=cpu
# pt | en | auto (detecção automática)
LANGUAGE=pt

# Velocidade do render: rapido (padrão, ~2,3x mais rápido) ou qualidade (arquivo quase igual, mais lento)
RENDER_SPEED=rapido

# Duração dos cortes (segundos)
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=90
